# Скопируйте в .env и поправьте под свою машину.
# Java нужна для Java-плагинов и для генерации данных из server.jar
# (для 26.3 — Java 25). Обычный запуск сервера без неё обходится: данные
# встроены в бинарник.
# Пути Windows пишите в одинарных кавычках, например: CHUNKWAKE_JAVA='C:/Java/jdk-25/bin/java.exe'
CHUNKWAKE_JAVA=java

# Только для сборки (`cargo build`). Сборка берёт данные в таком порядке:
# готовый архив, дерево кэша, затем `server.jar` + Java. Ничего не задано —
# ищутся `generated/26.3` и `server.jar` рядом с корнем проекта.
# Готовый zip вместо дерева данных:
# CHUNKWAKE_BUNDLE='C:/chunkwake/26.3-data.zip'
# Пустой бинарник без данных Mojang (для публичных релизов):
# CHUNKWAKE_BUNDLE=none
# Дерево кэша, например собранное в другом месте:
# CHUNKWAKE_DATA='C:/chunkwake/generated/26.3'
# Путь к server.jar, если он лежит не рядом с проектом:
# CHUNKWAKE_JAR='C:/Minecraft/server.jar'
