root = true

# По умолчанию — как в остальном коде: rustfmt и Java в этом проекте на 4 пробелах.
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# YAML (workflows, конфиги) — 2 пробела, отступы значимы.
[*.{yml,yaml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
