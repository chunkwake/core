<?xml version="1.0" encoding="UTF-8"?>
<!--
  Базовый log4j2 для встроенных библиотек (CraftEngine и др.).
  Paper показывает плагинам INFO, поэтому без этого файла log4j2 брал
  дефолт ERROR и все INFO-сообщения плагинов пропадали.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT" follow="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %c{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
