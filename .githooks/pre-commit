#!/bin/sh
# Обновляет счётчики механик в README и превью перед коммитом.
# Установка: git config core.hooksPath .githooks
set -eu

cd "$(git rev-parse --show-toplevel)"

# Хук нужен только когда меняется сама фич-матрица. Иначе он трогал бы
# README и превью на каждом коммите и мог бы застейджить чужие правки.
if ! git diff --cached --name-only -- docs/feature-matrix.md | grep -q .; then
    exit 0
fi

py=
for candidate in py python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && \
        "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        py=$candidate
        break
    fi
done
if [ -z "$py" ]; then
    echo "pre-commit: не найден Python 3.10+ — установите его или используйте git commit --no-verify" >&2
    exit 1
fi

"$py" scripts/readme_stats.py --stage
